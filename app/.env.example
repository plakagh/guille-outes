# Copy to .env.local and fill in with the output of `supabase status` (run in
# ../infra). `pnpm dev:all` writes this file for you on a fresh clone.
#
# NEXT_PUBLIC_* values are shipped to the browser. Everything else stays on the
# server: never put a NEXT_PUBLIC_ prefix on a secret.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- server only

# Bypasses Row Level Security. Used by exactly one module: the Redsys payment
# callback, which arrives from the bank with no user session and must move an
# order to "paid". Every other code path uses the visitor's own session.
# See app/README.md → Security model.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts the Redsys merchant secret before it is written to the database, so a
# pg_dump (which infra ships to object storage nightly) never contains a usable
# bank credential.
PAYMENTS_ENCRYPTION_KEY=

# Transactional email (order confirmations, failed payments). Locally point at
# Mailpit: host 127.0.0.1, port = `smtp_port` in infra/supabase/config.toml.
# Leave SMTP_HOST empty to disable sending entirely — the app degrades to a log
# line rather than failing an order.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=pedidos@guilleoutes.com
SMTP_SENDER_NAME=Guille Outes

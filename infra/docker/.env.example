############################################################
# Supabase self-hosted — production
#
# Copy this file to .env on the server and fill it in before
# running `docker compose up -d`. scripts/setup-vps.sh does the
# copy and generates every CHANGEME for you; what it cannot
# derive is marked "fill in by hand" below.
#
# This file is committed. .env is not, and never should be.
############################################################

# --- Postgres ---
# POSTGRES_PORT is the port *inside* the docker network. On the host, Postgres is
# published on 127.0.0.1:5433 only (see docker-compose.yml), never on 0.0.0.0.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGEME

# --- JWT ---
# ANON_KEY and SERVICE_ROLE_KEY are HS256 tokens signed with JWT_SECRET. They
# cannot be random: derive them with the snippet in ../README.md (First
# Production Deploy → Step 4). Fill in by hand.
JWT_SECRET=CHANGEME
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# --- API Gateway (Kong) ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGEME

# --- Auth (GoTrue) ---
SITE_URL=https://guilleoutes.com
# Every URL auth mail is allowed to redirect to. The confirmation link lands on
# our own /auth/confirm route, which verifies the token server-side and then
# forwards into the localised account page.
ADDITIONAL_REDIRECT_URLS=https://guilleoutes.com/auth/confirm,https://guilleoutes.com/es/cuenta,https://guilleoutes.com/gl/conta,https://guilleoutes.com/en/account
# false, not true: this is a shop with customer accounts. Setting it to true
# stops anyone from registering.
DISABLE_SIGNUP=false
API_EXTERNAL_URL=https://api.guilleoutes.com
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
# New accounts must confirm their address before they can sign in.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# --- Studio ---
# Not exposed to the internet — reachable only over an SSH tunnel. See
# ../README.md → "Accessing Studio in Production".
STUDIO_DEFAULT_ORGANIZATION=Guille Outes
STUDIO_DEFAULT_PROJECT=guille-outes
SUPABASE_PUBLIC_URL=https://api.guilleoutes.com
PGRST_DB_SCHEMAS=public,storage,graphql_public

# --- SMTP ---
# Used by GoTrue (confirmation, recovery, email change), by the storefront
# (order confirmations, failed payments) and by scripts/backup.sh to shout when
# a backup fails. Fill in by hand.
SMTP_ADMIN_EMAIL=pedidos@guilleoutes.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Guille Outes

# --- Storage ---
# STORAGE_BACKEND is `file` (see docker-compose.yml): images live on the server's
# disk under /opt/guille-outes-data/storage. The S3 values are stubs the storage
# API insists on reading even when it is not talking to S3.
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=local
S3_PROTOCOL_ACCESS_KEY_ID=stub
S3_PROTOCOL_ACCESS_KEY_SECRET=stub
IMGPROXY_AUTO_WEBP=true

# --- Realtime ---
SECRET_KEY_BASE=CHANGEME

# --- Postgres Meta ---
PG_META_CRYPTO_KEY=CHANGEME

# --- Storefront ---
# AES-256-GCM key protecting the Redsys merchant secret at rest, so the nightly
# pg_dump that leaves this machine carries no usable bank credential. Losing it
# means re-entering the merchant secret in the admin panel — recoverable.
#   openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=CHANGEME

# Overwritten on every deploy with the commit SHA that CI just built, so a
# rollback is a one-line edit here followed by:
#   docker compose --profile frontend up -d
FRONTEND_IMAGE=ghcr.io/plakagh/guille-outes-app:latest

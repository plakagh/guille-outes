############################################################
# Supabase self-hosted — production
# Copy this file to .env and fill in all values
# before running docker compose up -d
############################################################

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGEME

# --- JWT ---
JWT_SECRET=CHANGEME
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# --- API Gateway (Kong) ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGEME

# --- Auth (GoTrue) ---
SITE_URL=https://your-domain.com
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=true
API_EXTERNAL_URL=https://api.your-domain.com
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# --- Studio ---
STUDIO_DEFAULT_ORGANIZATION=Your Organization
STUDIO_DEFAULT_PROJECT=your-project
SUPABASE_PUBLIC_URL=https://api.your-domain.com
PGRST_DB_SCHEMAS=public,storage,graphql_public

# --- SMTP (for auth emails and backup alerts) ---
SMTP_ADMIN_EMAIL=admin@your-domain.com
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Your Project

# --- Storage ---
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=local
S3_PROTOCOL_ACCESS_KEY_ID=stub
S3_PROTOCOL_ACCESS_KEY_SECRET=stub
IMGPROXY_AUTO_WEBP=true

# --- Analytics (Logflare) ---
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGEME
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGEME

# --- Connection pooler (Supavisor) ---
SECRET_KEY_BASE=CHANGEME
VAULT_ENC_KEY=CHANGEME
POOLER_TENANT_ID=your-project-tenant
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=10
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_POOL_MODE=transaction

# --- Postgres Meta ---
PG_META_CRYPTO_KEY=CHANGEME

# --- Edge Functions ---
FUNCTIONS_VERIFY_JWT=false

# --- Vector (log shipping) ---
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# --- Frontend image ---
FRONTEND_IMAGE=ghcr.io/your-org/your-app:latest
